# Environments and caches
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ipynb_checkpoints/
.DS_Store
*.egg-info/
dist/
build/
.streamlit/secrets.toml
.claude/

# Logs carry absolute local paths
*.log

# Throwaway workspaces created by the track runners
.v1b_run/
.track_*/

# Experiment-tracker metadata and binary model files are regenerated by the pipeline
experiments/*/
!experiments/.gitkeep
outputs/models/
versions/*/outputs/models/
versions/*/experiments/

# Run state of the orchestrator
outputs/pipeline_state.json
versions/*/outputs/pipeline_state.json

# Internal review material and unpublished thesis text stay local
**/outputs/audit/opus_*
**/outputs/audit/fable_*
**/outputs/audit/*prompt*
**/outputs/reports/*.docx
**/outputs/reports/*_ACADEMIC.md
**/outputs/reports/DATA_AUTHENTICITY_AND_COVERAGE.md
scripts/build_*docx.py

# Downloaded source files (reports, spreadsheets); only extracted values and checksums are versioned
data/external_cache/
catboost_info/
