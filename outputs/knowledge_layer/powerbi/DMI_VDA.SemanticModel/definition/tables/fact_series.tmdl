				    Typed = Table.TransformColumnTypes(Promoted, {{"indicator_id", type text}, {"country_iso3", type text}, {"n_years", Int64.Type}, {"n_official", Int64.Type}, {"n_carried", Int64.Type}, {"n_reconstructed", Int64.Type}, {"n_missing", Int64.Type}, {"official_share", type number}, {"first_official_year", type number}, {"last_official_year", type number}, {"publication_lag_years", type number}, {"longest_non_official_run", Int64.Type}}, "en-US")
				in
