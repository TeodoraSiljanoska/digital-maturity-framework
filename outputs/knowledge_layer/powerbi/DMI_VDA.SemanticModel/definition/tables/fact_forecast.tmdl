	partition fact_forecast = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "fact_forecast.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"target", type text}, {"model", type text}, {"n_forecasts", Int64.Type}, {"rmse", type number}, {"mae", type number}, {"delta_rmse", type number}, {"ci_low", type number}, {"ci_high", type number}, {"origins_beating_persistence", Int64.Type}, {"rmse_txt", type text}, {"mae_txt", type text}, {"delta_rmse_txt", type text}, {"ci_txt", type text}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table

