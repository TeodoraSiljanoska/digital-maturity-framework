table fact_cell
	lineageTag: 69927e8f-ec84-57a1-87f1-e6b1be0c01ac

	measure Cells = COUNTROWS(fact_cell)
		formatString: 0
		lineageTag: 8b5d79c7-13b8-565c-8678-45fcd2ca0ca3

	measure 'Published cells' = CALCULATE(COUNTROWS(fact_cell), fact_cell[provenance] = "official") + 0
		formatString: 0
		lineageTag: 95f295b7-3fd0-54c2-9f29-4af82c2e9a47

	measure 'Published share' = DIVIDE([Published cells], [Cells])
		formatString: 0.0%
		lineageTag: 5b5b9a3f-a901-5fb3-abbc-58ea137b08f3

	measure 'Mean scaled value' = AVERAGE(fact_cell[value_norm])
		formatString: 0.0
		lineageTag: 824c8c80-bb7e-5261-89bd-52c5aab73792

	measure 'Published share (en)' = IF(ISBLANK([Published share]), BLANK(), FORMAT([Published share], "0.0%", "en-US"))
		lineageTag: 770a5afd-c51b-5c2c-a979-8a6c5bee1be1

