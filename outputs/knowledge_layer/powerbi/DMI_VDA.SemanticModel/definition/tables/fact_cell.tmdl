	partition fact_cell = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "fact_cell.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"cell_iri", type text}, {"indicator_id", type text}, {"country_iso3", type text}, {"year", Int64.Type}, {"value", type number}, {"value_norm", type number}, {"provenance", type text}, {"reconstruction_scope", type text}, {"edition", type text}, {"retrieval_method", type text}, {"source_id", type text}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table

