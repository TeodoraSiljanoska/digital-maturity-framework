	partition dim_source = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "dim_source.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"source_id", type text}, {"source_label", type text}, {"publisher", type text}, {"retrieved_at", type text}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table

