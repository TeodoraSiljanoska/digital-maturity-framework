table fact_dmi
	lineageTag: 2cf4a196-c86c-5d6b-906f-9227fa665878

	measure 'Average DMI' = AVERAGE(fact_dmi[DMI])
		formatString: 0.00
		lineageTag: f48c5af9-4156-51e0-91bb-1319001cbbf5

	measure 'Average DMI (published cells only)' = AVERAGE(fact_dmi[DMI_official_only])
		formatString: 0.00
		lineageTag: 8c02466f-05b4-503a-bff3-79a55ccd0b23

	measure 'Average DMI+' = AVERAGE(fact_dmi[DMI_plus])
		formatString: 0.00
		lineageTag: 70638260-b408-5eae-9435-b83f5ca2743c

	measure 'Average DMI (en)' = IF(ISBLANK([Average DMI]), BLANK(), FORMAT([Average DMI], "0.00", "en-US"))
		lineageTag: 05cb08a0-56e4-5595-9328-24866b8bb7a5

	measure 'Average DMI, published cells only (en)' = IF(ISBLANK([Average DMI (published cells only)]), BLANK(), FORMAT([Average DMI (published cells only)], "0.00", "en-US"))
		lineageTag: 85e84503-5ee8-5a35-9884-439fce27a2ef

