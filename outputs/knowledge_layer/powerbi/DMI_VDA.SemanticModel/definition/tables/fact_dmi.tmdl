	partition fact_dmi = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "fact_dmi.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"country_iso3", type text}, {"year", Int64.Type}, {"DMI", type number}, {"pillar_infrastructure", type number}, {"pillar_e_government", type number}, {"pillar_skills", type number}, {"pillar_trust_innovation", type number}, {"pillar_digital_economy", type number}, {"DMI_official_only", type number}, {"DMI_plus", type number}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table

