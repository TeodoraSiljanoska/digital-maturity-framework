        dmi:Phase_Analyse,
        dmi:Phase_Process,
        dmi:Phase_Visualize .

dmi:Phase_Index a dmi:ProcessPhase ;
    rdfs:label "Index" ;
    dmi:precedes dmi:Phase_Analyse .

dmi:Ind_DMI a dmi:CompositeIndex,
        dmi:Indicator,
        owl:NamedIndividual ;
    rdfs:label "Digital Maturity Index"@en,
        "Индекс на дигитална зрелост"@mk ;
    dmi:belongsToPillar dmi:Pillar_composite ;
    dmi:hasSource dmi:Source_constructed ;
    dmi:indicatorCode "DMI" ;
