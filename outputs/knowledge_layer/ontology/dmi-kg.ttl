dmi:Scope_interior a dmi:InteriorScope,
        owl:NamedIndividual ;
    rdfs:label "interior" .

dmi:Series_Z3_SRB a dmi:TimeSeries,
        owl:NamedIndividual ;
    dmi:longestGap 14 ;
    dmi:nOfficial 0 ;
    dmi:officialShare 0.0 ;
    dmi:seriesCountry dmi:Country_SRB ;
    dmi:seriesIndicator dmi:Ind_Z3 .

dmi:Series_Z5_AUS a dmi:TimeSeries,
        owl:NamedIndividual ;
    dmi:longestGap 14 ;
    dmi:nOfficial 0 ;
    dmi:officialShare 0.0 ;
    dmi:seriesCountry dmi:Country_AUS ;
    dmi:seriesIndicator dmi:Ind_Z5 .

dmi:SignificantEstimate a owl:Class ;
    rdfs:label "Estimate significant at 5%" ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( dmi:Estimate [ a owl:Restriction ;
                        owl:onProperty dmi:pValue ;
                        owl:someValuesFrom [ a rdfs:Datatype ;
                                owl:onDatatype xsd:decimal ;
                                owl:withRestrictions ( [ xsd:maxExclusive 0.05 ] ) ] ] ) ] .

dmi:SparseSeries a owl:Class ;
    rdfs:label "Sparse series (fewer than 7 published years)" ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( dmi:TimeSeries [ a owl:Restriction ;
                        owl:onProperty dmi:nOfficial ;
                        owl:someValuesFrom [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:maxExclusive 7 ] ) ] ] ) ] .

dmi:UnobservedSeries a owl:Class ;
    rdfs:label "Unobserved series" ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( dmi:TimeSeries [ a owl:Restriction ;
                        owl:hasValue 0 ;
                        owl:onProperty dmi:nOfficial ] ) ] .

dmi:View_context a dmi:AnalyticView,
        owl:NamedIndividual ;
    rdfs:label "Context indicators"@en,
        "Контекстни индикатори"@mk ;
    dmi:servesContext dmi:CTX_context_screening ;
    dmi:showsIndicator dmi:Ind_DMI,
        dmi:Ind_Z1,
        dmi:Ind_Z2,
        dmi:Ind_Z3,
        dmi:Ind_Z4,
        dmi:Ind_Z5,
        dmi:Ind_Z6 ;
    dmi:slicerField "dim_country.group_name",
        "dim_indicator.indicator_label",
        "dim_year.year" ;
    dmi:supportsTask dmi:Task_compare,
        dmi:Task_filter,
        dmi:Task_trend .

dmi:View_models a dmi:AnalyticView,
        owl:NamedIndividual ;
    rdfs:label "Models and explanations"@en,
        "Модели и објаснувања"@mk ;
    dmi:servesContext dmi:CTX_prediction_xai ;
    dmi:showsIndicator dmi:Ind_C1,
        dmi:Ind_C2,
        dmi:Ind_X1,
        dmi:Ind_X10,
        dmi:Ind_X2,
        dmi:Ind_X3,
        dmi:Ind_X4,
        dmi:Ind_X5,
        dmi:Ind_X6,
        dmi:Ind_X7,
        dmi:Ind_X8,
        dmi:Ind_X9 ;
    dmi:slicerField "fact_estimate.arm",
        "fact_forecast.target" ;
    dmi:supportsTask dmi:Task_compare,
        dmi:Task_details .

dmi:View_monitoring a dmi:AnalyticView,
        owl:NamedIndividual ;
    rdfs:label "Monitoring"@en,
        "Мониторинг на дигиталната зрелост"@mk ;
    dmi:servesContext dmi:CTX_overview_dashboard ;
    dmi:showsIndicator dmi:Ind_DMI ;
    dmi:slicerField "dim_country.country_name",
        "dim_country.group_name",
        "dim_year.year" ;
    dmi:supportsTask dmi:Task_compare,
        dmi:Task_filter,
        dmi:Task_overview,
        dmi:Task_trend .

dmi:View_provenance a dmi:AnalyticView,
        owl:NamedIndividual ;
    rdfs:label "Provenance"@en,
        "Потекло на вредностите"@mk ;
    dmi:servesContext dmi:CTX_provenance_audit ;
    dmi:showsIndicator dmi:Ind_C1,
        dmi:Ind_C2,
        dmi:Ind_X1,
        dmi:Ind_X10,
        dmi:Ind_X2,
        dmi:Ind_X3,
        dmi:Ind_X4,
        dmi:Ind_X5,
        dmi:Ind_X6,
        dmi:Ind_X7,
        dmi:Ind_X8,
        dmi:Ind_X9,
        dmi:Ind_Z1,
        dmi:Ind_Z2,
        dmi:Ind_Z3,
        dmi:Ind_Z4,
        dmi:Ind_Z5,
        dmi:Ind_Z6 ;
    dmi:slicerField "dim_country.group_name",
        "dim_indicator.family",
        "dim_provenance.state",
        "dim_source.publisher" ;
    dmi:supportsTask dmi:Task_details,
        dmi:Task_filter,
        dmi:Task_provenance .

dmi:aboutIndicator a owl:ObjectProperty ;
    rdfs:domain dmi:Explanation ;
    rdfs:range dmi:Indicator .

dmi:assignedToPhase a owl:ObjectProperty ;
    rdfs:domain dmi:ModelOutput ;
    rdfs:range dmi:ProcessPhase .

dmi:ciHigh a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:range xsd:decimal .

dmi:ciLow a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:range xsd:decimal .

dmi:coefficient a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain dmi:Estimate ;
    rdfs:range xsd:decimal .

dmi:coefficientOfVariation a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain dmi:DispersionReading ;
    rdfs:range xsd:decimal .

dmi:deltaRmseVsPersistence a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain dmi:ForecastScore ;
    rdfs:range xsd:decimal .

dmi:edition a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "Publisher edition from which an official value was read." ;
    rdfs:domain dmi:ScoreEntry ;
    rdfs:range xsd:string .

dmi:entryPhase a owl:ObjectProperty ;
    rdfs:domain dmi:ScoreEntry ;
    rdfs:range dmi:ProcessPhase ;
    rdfs:subPropertyOf prov:wasGeneratedBy .

dmi:entrySource a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain dmi:ScoreEntry ;
    rdfs:range dmi:DataSource ;
    rdfs:subPropertyOf prov:wasDerivedFrom .

dmi:estimateFor a owl:ObjectProperty ;
    rdfs:domain dmi:Estimate ;
    rdfs:range dmi:Indicator .

dmi:estimationArm a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:range xsd:string .

dmi:estimator a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:range xsd:string .

dmi:evaluatedWith a owl:ObjectProperty ;
    rdfs:domain dmi:EvaluationRun ;
    rdfs:range dmi:ValidationQuery .

dmi:evaluates a owl:ObjectProperty ;
    rdfs:domain dmi:EvaluationRun ;
    rdfs:range dmi:CompetencyQuestion .

dmi:expectedAnswerText a owl:DatatypeProperty ;
    rdfs:range xsd:string .

dmi:explainsOutput a owl:ObjectProperty ;
    rdfs:domain dmi:Explanation ;
    rdfs:range dmi:ModelOutput .

dmi:firstOfficialYear a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain dmi:TimeSeries ;
    rdfs:range xsd:integer .

dmi:forecastTarget a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain dmi:ForecastScore ;
    rdfs:range xsd:string .

dmi:hasContext a owl:ObjectProperty ;
    rdfs:domain dmi:Recommendation ;
    rdfs:range dmi:DecisionContext .

dmi:hasSource a owl:ObjectProperty ;
    rdfs:domain dmi:Indicator ;
    rdfs:range dmi:DataSource .

dmi:inSeries a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain dmi:ScoreEntry ;
    rdfs:range dmi:TimeSeries .

dmi:indicatorCode a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:range xsd:string .

dmi:indicatorId a owl:DatatypeProperty ;
    rdfs:range xsd:string .

dmi:iso3 a owl:DatatypeProperty ;
    rdfs:range xsd:string .

dmi:lastOfficialYear a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain dmi:TimeSeries ;
    rdfs:range xsd:integer .

dmi:longestGap a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "Longest run of consecutive years without a published value." ;
    rdfs:domain dmi:TimeSeries ;
    rdfs:range xsd:integer .

dmi:mae a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain dmi:ForecastScore ;
    rdfs:range xsd:decimal .

dmi:matrixValue a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:range xsd:decimal .

dmi:meanAbsShap a owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

dmi:obtainedBy a owl:ObjectProperty ;
    rdfs:domain dmi:Indicator ;
    rdfs:range dmi:CollectionMethod .

dmi:officialShare a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain dmi:TimeSeries ;
    rdfs:range xsd:decimal .

dmi:pillarWeight a owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

dmi:polarity a owl:DatatypeProperty ;
    rdfs:range xsd:string .

dmi:precedes a owl:ObjectProperty ;
    rdfs:domain dmi:ProcessPhase ;
    rdfs:range dmi:ProcessPhase .

dmi:primaryPublisher a owl:ObjectProperty ;
    rdfs:comment "Organisation that compiles the series behind the distributor (e.g. UNESCO UIS behind WDI)." ;
    rdfs:domain dmi:Indicator ;
    rdfs:range dmi:Publisher .

dmi:publishedBy a owl:ObjectProperty ;
    rdfs:domain dmi:DataSource ;
    rdfs:range dmi:Publisher ;
    rdfs:subPropertyOf prov:wasAttributedTo .

dmi:queryText a owl:DatatypeProperty ;
    rdfs:range xsd:string .

dmi:questionText a owl:DatatypeProperty ;
    rdfs:range xsd:string .

dmi:realizesKind a owl:ObjectProperty ;
    rdfs:domain dmi:CollectionMethod ;
    rdfs:range dmi:HiTEcDataKind .

dmi:relatedPillar a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:comment "Thematic link of a context indicator; unlike dmi:belongsToPillar it does not enter the index." ;
    rdfs:domain dmi:ContextIndicator ;
    rdfs:range dmi:Pillar .

dmi:retrievalMethod a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "api, html, pdf, csv or xlsx." ;
    rdfs:domain dmi:ScoreEntry ;
    rdfs:range xsd:string .

dmi:retrievedAt a owl:DatatypeProperty ;
    rdfs:comment "UTC time at which the stored vintage of an API source was retrieved (xsd:date is outside the OWL 2 datatype map)." ;
    rdfs:domain dmi:DataSource ;
    rdfs:range xsd:dateTime .

dmi:rmse a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain dmi:ForecastScore ;
    rdfs:range xsd:decimal .

dmi:role a owl:DatatypeProperty ;
    rdfs:range xsd:string .

dmi:scoredModel a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain dmi:ForecastScore ;
    rdfs:range dmi:ModelOutput .

dmi:seriesCountry a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain dmi:TimeSeries ;
    rdfs:range dmi:Country .

dmi:seriesIndicator a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain dmi:TimeSeries ;
    rdfs:range dmi:Indicator .

dmi:servesContext a owl:ObjectProperty ;
    rdfs:domain dmi:AnalyticView ;
    rdfs:range dmi:DecisionContext .

dmi:showsIndicator a owl:ObjectProperty ;
    rdfs:domain dmi:AnalyticView ;
    rdfs:range dmi:Indicator .

dmi:sigmaReading a owl:DatatypeProperty ;
    rdfs:comment "Superseded in 2.0.0 by dmi:DispersionReading individuals." ;
    rdfs:range xsd:string ;
    owl:deprecated true .

dmi:slicerField a owl:DatatypeProperty ;
    rdfs:domain dmi:AnalyticView ;
    rdfs:range xsd:string .

dmi:stdError a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain dmi:Estimate ;
    rdfs:range xsd:decimal .

dmi:supportsTask a owl:ObjectProperty ;
    rdfs:domain dmi:AnalyticView ;
    rdfs:range dmi:VisualTask .

dmi:unit a owl:DatatypeProperty ;
    rdfs:range xsd:string .

dmi:usedInPhase a owl:ObjectProperty ;
    rdfs:domain dmi:Indicator ;
    rdfs:range dmi:ProcessPhase .

dmi:usesValidationQuery a owl:ObjectProperty ;
    rdfs:domain dmi:CompetencyQuestion ;
    rdfs:range dmi:ValidationQuery .

dmi:validationPassed a owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

dmi:verification a owl:DatatypeProperty ;
    rdfs:domain dmi:ScoreEntry ;
    rdfs:range xsd:string .

qb:dataSet a owl:ObjectProperty .

skos:definition a owl:AnnotationProperty .

skos:inScheme a owl:ObjectProperty .

skos:prefLabel a owl:AnnotationProperty .

dmi:CTX_context_screening a dmi:DecisionContext,
        owl:NamedIndividual ;
    rdfs:label "Context screening" ;
    rdfs:comment "How official series outside the composite move with the DMI." .

dmi:CTX_overview_dashboard a dmi:DecisionContext ;
    rdfs:label "Data overview for monitoring" ;
    rdfs:comment "UL_DO analogue: country/group DMI overview → dashboards, line charts, sliders." .

dmi:CTX_prediction_xai a dmi:DecisionContext ;
    rdfs:label "Prediction and explanation" ;
    rdfs:comment "Hold-out prediction plus SHAP/LIME/PDP." .

dmi:CTX_provenance_audit a dmi:DecisionContext,
        owl:NamedIndividual ;
    rdfs:label "Provenance audit" ;
    rdfs:comment "Which cells of a selection are published, carried or reconstructed, and from which edition." .

dmi:Kind_perceptions a dmi:HiTEcDataKind ;
    rdfs:label "Perceptions / imprecise data" ;
    rdfs:comment "HiTEc MoU: polls, perceptions, non-precise values. Unused as primary collection." .

dmi:Kind_sensor a dmi:HiTEcDataKind ;
    rdfs:label "Sensor data" ;
    rdfs:comment "HiTEc MoU emphasis (environmental/health streams). Unused in this study." .

dmi:Method_constructed a dmi:CollectionMethod ;
    rdfs:label "Constructed composite" ;
    rdfs:comment "Derived inside the framework (DMI), not an external HiTEc source kind." .

dmi:Phase_Validate a dmi:ProcessPhase ;
    rdfs:label "Validate" ;
    dmi:precedes dmi:Phase_Process .

dmi:Pillar_composite a dmi:NonCompositePillar,
        dmi:Pillar ;
    rdfs:label "Composite DMI" ;
    dmi:pillarWeight 1.00 ;
    skos:inScheme dmi:PillarScheme ;
    skos:prefLabel "Composite DMI"@en,
        "Композитен DMI"@mk .

dmi:Publisher_imf a dmi:Publisher,
        owl:NamedIndividual ;
    rdfs:label "International Monetary Fund"@en .

dmi:Publisher_netcraft a dmi:Publisher,
        owl:NamedIndividual ;
    rdfs:label "Netcraft"@en .

dmi:Publisher_un_statistics_division a dmi:Publisher,
        owl:NamedIndividual ;
    rdfs:label "United Nations Statistics Division"@en .

dmi:Publisher_unctad a dmi:Publisher,
        owl:NamedIndividual ;
    rdfs:label "United Nations Conference on Trade and Development"@en .

dmi:Recommendation a owl:Class ;
    rdfs:comment "Cdec slot for a policy recommendation. Unused in this study: VDA is filter and slider, not a recommender, so no Recommendation individuals are asserted." ;
    rdfs:subClassOf dmi:Cdec .

dmi:ReconstructedEntry a owl:Class ;
    rdfs:label "Reconstructed cell" ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( dmi:ScoreEntry [ a owl:Restriction ;
                        owl:onProperty dmi:hasProvenance ;
                        owl:someValuesFrom dmi:ReconstructedState ] ) ] .

dmi:Task_overview a dmi:VisualTask,
        owl:NamedIndividual ;
    rdfs:label "Overview" .

dmi:Task_provenance a dmi:VisualTask,
        owl:NamedIndividual ;
    rdfs:label "Inspect the provenance of a value" .

dmi:VQ_CQ1 a dmi:ValidationQuery,
        owl:NamedIndividual ;
    dmi:queryText """PREFIX dmi: <http://purl.org/dmi-framework#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?id ?m WHERE { ?i a dmi:Indicator ; dmi:indicatorId ?id ; dmi:obtainedBy ?mm . BIND(STRAFTER(STR(?mm), 'Method_') AS ?m) } ORDER BY ?id""" .

dmi:VQ_CQ10 a dmi:ValidationQuery,
        owl:NamedIndividual ;
    dmi:queryText """PREFIX dmi: <http://purl.org/dmi-framework#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?arm ?id WHERE { ?e a dmi:Estimate ; dmi:estimationArm ?arm ; dmi:pValue ?p ; dmi:estimateFor/dmi:indicatorId ?id . FILTER (?p < 0.05) } ORDER BY ?arm ?id""" .

dmi:VQ_CQ11 a dmi:ValidationQuery,
        owl:NamedIndividual ;
    dmi:queryText """PREFIX dmi: <http://purl.org/dmi-framework#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?y ?cv WHERE { ?d a dmi:DispersionReading ; dmi:year ?y ; dmi:coefficientOfVariation ?cv . FILTER (?y IN (2012, 2025)) } ORDER BY ?y""" .

dmi:VQ_CQ12 a dmi:ValidationQuery,
        owl:NamedIndividual ;
    dmi:queryText """PREFIX dmi: <http://purl.org/dmi-framework#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?t ?m WHERE { ?f a dmi:ForecastScore ; dmi:forecastTarget ?t ; dmi:ciHigh ?hi ; dmi:scoredModel/rdfs:label ?m . FILTER (?hi < 0) } ORDER BY ?t ?m""" .

dmi:VQ_CQ13 a dmi:ValidationQuery,
        owl:NamedIndividual ;
    dmi:queryText """PREFIX dmi: <http://purl.org/dmi-framework#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?ed (COUNT(?e) AS ?n) WHERE { ?e dmi:entryIndicator dmi:Ind_X7 ; dmi:hasProvenance dmi:Prov_official ; dmi:edition ?ed } GROUP BY ?ed ORDER BY ?ed""" .

dmi:VQ_CQ14 a dmi:ValidationQuery,
        owl:NamedIndividual ;
    dmi:queryText """PREFIX dmi: <http://purl.org/dmi-framework#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT DISTINCT ?view ?field WHERE { ?v a dmi:AnalyticView ; dmi:showsIndicator ?i ; dmi:slicerField ?field ; rdfs:label ?view . ?i a dmi:ContextIndicator . FILTER (LANG(?view) = 'en') } ORDER BY ?view ?field""" .

dmi:VQ_CQ2 a dmi:ValidationQuery,
        owl:NamedIndividual ;
    dmi:queryText """PREFIX dmi: <http://purl.org/dmi-framework#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?p (COUNT(?e) AS ?n) WHERE { ?e a dmi:ScoreEntry ; dmi:entryCountry dmi:Country_MKD ; dmi:year 2025 ; dmi:hasProvenance ?pp . BIND(STRAFTER(STR(?pp), 'Prov_') AS ?p) } GROUP BY ?p ORDER BY ?p""" .

dmi:VQ_CQ3 a dmi:ValidationQuery,
        owl:NamedIndividual ;
    dmi:queryText """PREFIX dmi: <http://purl.org/dmi-framework#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?m ?ph WHERE { ?f a dmi:ForecastScore ; dmi:scoredModel ?mm . ?mm dmi:assignedToPhase ?p ; rdfs:label ?m . ?p rdfs:label ?ph } GROUP BY ?m ?ph ORDER BY ?m""" .

dmi:VQ_CQ4 a dmi:ValidationQuery,
        owl:NamedIndividual ;
    dmi:queryText """PREFIX dmi: <http://purl.org/dmi-framework#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?id ?model WHERE { ?e a dmi:Explanation ; dmi:aboutIndicator ?i ; dmi:meanAbsShap ?s ; dmi:explainsOutput ?m . ?i dmi:indicatorId ?id . ?m rdfs:label ?model } ORDER BY DESC(?s) LIMIT 5""" .

dmi:VQ_CQ5 a dmi:ValidationQuery,
        owl:NamedIndividual ;
    dmi:queryText """PREFIX dmi: <http://purl.org/dmi-framework#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?id ?v ?p WHERE { ?e a dmi:ScoreEntry ; dmi:entryCountry dmi:Country_MKD ; dmi:year 2025 ; dmi:entryIndicator ?i ; dmi:matrixValue ?v ; dmi:hasProvenance ?pp ; dmi:entrySource ?s . ?i dmi:indicatorId ?id . BIND(STRAFTER(STR(?pp), 'Prov_') AS ?p) } ORDER BY ?id""" .

dmi:VQ_CQ6 a dmi:ValidationQuery,
        owl:NamedIndividual ;
    dmi:queryText """PREFIX dmi: <http://purl.org/dmi-framework#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT (COUNT(DISTINCT ?c) AS ?nc) (COUNT(DISTINCT ?i) AS ?ni) WHERE { ?c a dmi:Country . ?i a dmi:Indicator }""" .

dmi:VQ_CQ7 a dmi:ValidationQuery,
        owl:NamedIndividual ;
    dmi:queryText """PREFIX dmi: <http://purl.org/dmi-framework#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?id ?iso WHERE { ?s a dmi:TimeSeries ; dmi:nOfficial 0 ; dmi:seriesIndicator/dmi:indicatorId ?id ; dmi:seriesCountry/dmi:iso3 ?iso } ORDER BY ?id ?iso""" .

dmi:VQ_CQ8 a dmi:ValidationQuery,
        owl:NamedIndividual ;
    dmi:queryText """PREFIX dmi: <http://purl.org/dmi-framework#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?y (SUM(IF(?p = dmi:Prov_official, 1, 0)) AS ?off) (COUNT(?e) AS ?n) WHERE {
  ?e a dmi:ScoreEntry ; dmi:year ?y ; dmi:hasProvenance ?p ; dmi:entryCountry/dmi:memberOf dmi:Group_balkan ;
     dmi:entryIndicator/dmi:belongsToPillar ?pl .
  VALUES ?pl { dmi:Pillar_infrastructure dmi:Pillar_e_government dmi:Pillar_skills dmi:Pillar_trust_innovation dmi:Pillar_digital_economy }
} GROUP BY ?y ORDER BY ?y""" .

dmi:VQ_CQ9 a dmi:ValidationQuery,
        owl:NamedIndividual ;
    dmi:queryText """PREFIX dmi: <http://purl.org/dmi-framework#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?id ?pillar ?y ?v WHERE {
  ?i a dmi:ContextIndicator ; dmi:indicatorId ?id ; dmi:relatedPillar ?pp .
  BIND(STRAFTER(STR(?pp), 'Pillar_') AS ?pillar)
  ?e dmi:entryIndicator ?i ; dmi:entryCountry dmi:Country_MKD ; dmi:hasProvenance dmi:Prov_official ; dmi:year ?y ; dmi:matrixValue ?v .
  FILTER NOT EXISTS { ?e2 dmi:entryIndicator ?i ; dmi:entryCountry dmi:Country_MKD ; dmi:hasProvenance dmi:Prov_official ; dmi:year ?y2 . FILTER (?y2 > ?y) }
} ORDER BY ?id""" .

dmi:entryGroup a owl:ObjectProperty ;
    rdfs:comment "Inferred: the country group of the cell." ;
    rdfs:domain dmi:ScoreEntry ;
    rdfs:range dmi:CountryGroup ;
    owl:propertyChainAxiom ( dmi:entryCountry dmi:memberOf ) .

dmi:entryPillar a owl:ObjectProperty ;
    rdfs:comment "Inferred: the DMI pillar of the cell." ;
    rdfs:domain dmi:ScoreEntry ;
    rdfs:range dmi:Pillar ;
    owl:propertyChainAxiom ( dmi:entryIndicator dmi:belongsToPillar ) .

dmi:hasReconstructionScope a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain dmi:ScoreEntry ;
    rdfs:range dmi:ReconstructionScope .

dmi:memberOf a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain dmi:Country ;
    rdfs:range dmi:CountryGroup .

dmi:pValue a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain dmi:Estimate ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:decimal ;
            owl:withRestrictions ( [ xsd:minInclusive 0.0 ] [ xsd:maxInclusive 1.0 ] ) ] .

qb:DataSet a owl:Class .

qb:Observation a owl:Class .

skos:Concept a owl:Class .

skos:ConceptScheme a owl:Class .

dcat:Dataset a owl:Class .

prov:Activity a owl:Class .

prov:Agent a owl:Class .

prov:Organization a owl:Class ;
    rdfs:subClassOf prov:Agent .

prov:wasAttributedTo a owl:ObjectProperty .

prov:wasDerivedFrom a owl:ObjectProperty .

prov:wasGeneratedBy a owl:ObjectProperty .

dmi:BalkanGroup a owl:Class ;
    rdfs:label "Balkan country group" ;
    rdfs:subClassOf dmi:CountryGroup .

dmi:CompositeIndex a owl:Class ;
    rdfs:label "Composite index" ;
    rdfs:comment "The constructed dependent variable (DMI)." ;
    rdfs:subClassOf dmi:Indicator .

dmi:EvaluationRun a owl:Class ;
    rdfs:comment "One rdflib SPARQL execution of a competency question. Not a DL reasoner run." ;
    rdfs:subClassOf dmi:Ceval .

dmi:ForecastScope a owl:Class ;
    rdfs:subClassOf dmi:ReconstructionScope .

dmi:InteriorScope a owl:Class ;
    rdfs:subClassOf dmi:ReconstructionScope .

dmi:Kind_traditional a dmi:HiTEcDataKind ;
    rdfs:label "Traditional official series" ;
    rdfs:comment "HiTEc MoU: traditional data combined with complex sources. Used in this study." .

dmi:MissingState a owl:Class ;
    rdfs:label "No value" ;
    rdfs:subClassOf dmi:ProvenanceState .

dmi:Model_catboost a dmi:ModelOutput,
        owl:NamedIndividual ;
    rdfs:label "catboost" ;
    dmi:assignedToPhase dmi:Phase_Predict ;
    rdfs:comment "Non-linear prediction of DMI" .

dmi:Model_catboost_arx a dmi:ModelOutput,
        owl:NamedIndividual ;
    rdfs:label "catboost_arx" ;
    dmi:assignedToPhase dmi:Phase_Predict ;
    rdfs:comment "CatBoost with the lagged DMI as an extra input" .

dmi:Model_ols a dmi:ModelOutput,
        owl:NamedIndividual ;
    rdfs:label "ols" ;
    dmi:assignedToPhase dmi:Phase_Predict ;
    rdfs:comment "Linear baseline for H1.6" .

dmi:Model_persistence a dmi:ModelOutput,
        owl:NamedIndividual ;
    rdfs:label "persistence" ;
    dmi:assignedToPhase dmi:Phase_Predict ;
    rdfs:comment "Naive forecast: the DMI of the previous year" .

dmi:Model_random_forest a dmi:ModelOutput,
        owl:NamedIndividual ;
    rdfs:label "random_forest" ;
    dmi:assignedToPhase dmi:Phase_Predict ;
    rdfs:comment "Non-linear prediction of DMI" .

dmi:Model_ridge_arx a dmi:ModelOutput,
        owl:NamedIndividual ;
    rdfs:label "ridge_arx" ;
    dmi:assignedToPhase dmi:Phase_Predict ;
    rdfs:comment "Ridge regression with the lagged DMI as an extra input" .

dmi:Model_svr a dmi:ModelOutput,
        owl:NamedIndividual ;
    rdfs:label "svr" ;
    dmi:assignedToPhase dmi:Phase_Predict ;
    rdfs:comment "Non-linear prediction of DMI" .

dmi:Model_xgboost a dmi:ModelOutput,
        owl:NamedIndividual ;
    rdfs:label "xgboost" ;
    dmi:assignedToPhase dmi:Phase_Predict ;
    rdfs:comment "Non-linear prediction of DMI" .

dmi:NonCompositePillar a owl:Class ;
    rdfs:label "Grouping outside the composite (controls, the composite itself)" ;
    rdfs:subClassOf dmi:Pillar ;
    owl:disjointWith dmi:CompositePillar .

dmi:Pillar_control a dmi:NonCompositePillar,
        dmi:Pillar ;
    rdfs:label "Control (not in DMI)" ;
    dmi:pillarWeight 0.00 ;
    skos:inScheme dmi:PillarScheme ;
    skos:prefLabel "Control (not in DMI)"@en,
        "Контролни (надвор од DMI)"@mk .

dmi:Pillar_e_government a dmi:CompositePillar,
        dmi:Pillar ;
    rdfs:label "E-government" ;
    dmi:pillarWeight 0.20 ;
    skos:inScheme dmi:PillarScheme ;
    skos:prefLabel "E-government"@en,
        "Е-влада"@mk .

dmi:Pillar_infrastructure a dmi:CompositePillar,
        dmi:Pillar ;
    rdfs:label "Infrastructure" ;
    dmi:pillarWeight 0.20 ;
    skos:inScheme dmi:PillarScheme ;
    skos:prefLabel "Infrastructure"@en,
        "Инфраструктура"@mk .

dmi:Pillar_skills a dmi:CompositePillar,
        dmi:Pillar ;
    rdfs:label "Skills" ;
    dmi:pillarWeight 0.20 ;
    skos:inScheme dmi:PillarScheme ;
    skos:prefLabel "Skills"@en,
        "Вештини"@mk .

dmi:Publisher_ega a dmi:Publisher,
        owl:NamedIndividual ;
    rdfs:label "e-Governance Academy"@en .

dmi:Publisher_oxford_insights a dmi:Publisher,
        owl:NamedIndividual ;
    rdfs:label "Oxford Insights"@en .

dmi:Publisher_undp_hdro a dmi:Publisher,
        owl:NamedIndividual ;
    rdfs:label "UNDP Human Development Report Office"@en .

dmi:Publisher_wipo a dmi:Publisher,
        owl:NamedIndividual ;
    rdfs:label "World Intellectual Property Organization"@en .

dmi:Task_details a dmi:VisualTask,
        owl:NamedIndividual ;
    rdfs:label "Details on demand" .

dmi:Task_trend a dmi:VisualTask,
        owl:NamedIndividual ;
    rdfs:label "Follow a trend over time" .

dmi:entryCountry a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain dmi:ScoreEntry ;
    rdfs:range dmi:Country .

dmi:nOfficial a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain dmi:TimeSeries ;
    rdfs:range xsd:integer .

dmi:year a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:range xsd:integer .

prov:Entity a owl:Class .

dmi:BackcastScope a owl:Class ;
    rdfs:subClassOf dmi:ReconstructionScope .

dmi:CarriedState a owl:Class ;
    rdfs:label "Carried from the nearest publication (at most two years)" ;
    rdfs:subClassOf dmi:ProvenanceState .

dmi:Ceval a owl:Class ;
    rdfs:label "Evaluation class" .

dmi:ConstructedState a owl:Class ;
    rdfs:label "Constructed by the framework" ;
    rdfs:subClassOf dmi:ProvenanceState .

dmi:ControlIndicator a owl:Class ;
    rdfs:label "Control indicator" ;
    rdfs:comment "Control C1 or C2; analysed, never part of the composite." ;
    rdfs:subClassOf dmi:Indicator .

dmi:Group_balkan a dmi:BalkanGroup,
        dmi:CountryGroup,
        owl:NamedIndividual ;
    rdfs:label "Balkan countries"@en,
        "Балкански земји"@mk .

dmi:Group_developed_eu a dmi:CountryGroup,
        owl:NamedIndividual ;
    rdfs:label "Developed European countries"@en,
        "Развиени европски земји"@mk .

dmi:Group_developed_non_eu a dmi:CountryGroup,
        owl:NamedIndividual ;
    rdfs:label "Developed non-European countries"@en,
        "Развиени воневропски земји"@mk .

dmi:Group_developing a dmi:CountryGroup,
        owl:NamedIndividual ;
    rdfs:label "Developing countries"@en,
        "Земји во развој"@mk .

dmi:OfficialState a owl:Class ;
    rdfs:label "Published by the source" ;
    rdfs:subClassOf dmi:ProvenanceState .

dmi:Publisher_itu a dmi:Publisher,
        owl:NamedIndividual ;
    rdfs:label "International Telecommunication Union"@en .

dmi:Publisher_un_desa a dmi:Publisher,
        owl:NamedIndividual ;
    rdfs:label "United Nations Department of Economic and Social Affairs"@en .

dmi:Publisher_unesco_uis a dmi:Publisher,
        owl:NamedIndividual ;
    rdfs:label "UNESCO Institute for Statistics"@en .

dmi:ReconstructedState a owl:Class ;
    rdfs:label "Reconstructed by chained-equation imputation" ;
    rdfs:subClassOf dmi:ProvenanceState .

dmi:Task_compare a dmi:VisualTask,
        owl:NamedIndividual ;
    rdfs:label "Compare" .

dmi:Task_filter a dmi:VisualTask,
        owl:NamedIndividual ;
    rdfs:label "Filter" .

dmi:belongsToPillar a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain dmi:Indicator ;
    rdfs:range dmi:Pillar .

dmi:entryIndicator a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain dmi:ScoreEntry ;
    rdfs:range dmi:Indicator .

dmi:Publisher_world_bank a dmi:Publisher,
        owl:NamedIndividual ;
    rdfs:label "World Bank"@en .

dmi:Phase_Explain a dmi:ProcessPhase ;
    rdfs:label "Explain" ;
    dmi:precedes dmi:Phase_Visualize .

dmi:Pillar_digital_economy a dmi:CompositePillar,
        dmi:Pillar ;
    rdfs:label "Digital economy" ;
    dmi:pillarWeight 0.20 ;
    skos:inScheme dmi:PillarScheme ;
    skos:prefLabel "Digital economy"@en,
        "Дигитална економија"@mk .

dmi:Pillar_trust_innovation a dmi:CompositePillar,
        dmi:Pillar ;
    rdfs:label "Trust and innovation" ;
    dmi:pillarWeight 0.20 ;
    skos:inScheme dmi:PillarScheme ;
    skos:prefLabel "Trust and innovation"@en,
        "Доверба и иновации"@mk .

dmi:ReconstructionScope a owl:Class ;
    rdfs:label "Reconstruction scope" ;
    rdfs:comment "Position of a reconstructed cell in its series: interior, backcast or forecast." ;
    rdfs:subClassOf dmi:Ctax .

dmi:Scope_forecast a dmi:ForecastScope,
        owl:NamedIndividual ;
    rdfs:label "forecast" .

dmi:Series_Z5_BRA a dmi:TimeSeries,
        owl:NamedIndividual ;
    dmi:firstOfficialYear 2012 ;
    dmi:lastOfficialYear 2014 ;
