dmi:Kind_functional a dmi:HiTEcDataKind ;
    rdfs:label "Functional data" ;
    rdfs:comment "HiTEc MoU: functions, continuously recorded curves. Unused in this study." .

dmi:Kind_text a dmi:HiTEcDataKind ;
    rdfs:label "Text data" ;
    rdfs:comment "HiTEc MoU: newspapers, articles, opinions. Unused in this study." .

dmi:Method_primary_survey a dmi:CollectionMethod ;
    rdfs:label "Primary field survey" ;
    dmi:realizesKind dmi:Kind_perceptions ;
    rdfs:comment "Not used. Closest HiTEc kind: perceptions/imprecise data." .

dmi:Method_sensor_automated a dmi:CollectionMethod ;
    rdfs:label "Automated / sensor capture" ;
    dmi:realizesKind dmi:Kind_sensor ;
    rdfs:comment "Not used. HiTEc MoU emphasises sensor data; this panel has none." .

dmi:Model_curated_snapshot_loaders a dmi:ModelOutput,
        owl:NamedIndividual ;
    rdfs:label "curated_snapshot_loaders" ;
    dmi:assignedToPhase dmi:Phase_Acquire ;
    rdfs:comment "Load versioned UN EGDI, NCSI, GII, Oxford, UNDP snapshots" .

dmi:Model_dmi_weighted_pillars a dmi:ModelOutput,
        owl:NamedIndividual ;
    rdfs:label "dmi_weighted_pillars" ;
    dmi:assignedToPhase dmi:Phase_Index ;
    rdfs:comment "Construct dependent variable Y" .

dmi:Model_lightgbm a dmi:ModelOutput,
        owl:NamedIndividual ;
    rdfs:label "lightgbm" ;
    dmi:assignedToPhase dmi:Phase_Predict ;
    rdfs:comment "Non-linear prediction of DMI" .

dmi:Model_lime a dmi:ModelOutput,
        owl:NamedIndividual ;
    rdfs:label "lime" ;
    dmi:assignedToPhase dmi:Phase_Explain ;
    rdfs:comment "Local model-agnostic explanation" .

dmi:Model_linear_regression a dmi:ModelOutput,
        owl:NamedIndividual ;
    rdfs:label "linear_regression" ;
    dmi:assignedToPhase dmi:Phase_Predict ;
    rdfs:comment "Linear baseline for H1.6" .

dmi:Model_mice a dmi:ModelOutput,
        owl:NamedIndividual ;
    rdfs:label "mice" ;
    dmi:assignedToPhase dmi:Phase_Process ;
    rdfs:comment "Complete remaining missing cells; never overwrite official values" .

dmi:Model_mlp a dmi:ModelOutput,
        owl:NamedIndividual ;
    rdfs:label "mlp" ;
    dmi:assignedToPhase dmi:Phase_Predict ;
    rdfs:comment "Non-linear prediction of DMI (unstable on this n)" .

dmi:Model_pdp a dmi:ModelOutput,
        owl:NamedIndividual ;
    rdfs:label "pdp" ;
    dmi:assignedToPhase dmi:Phase_Explain ;
    rdfs:comment "Marginal response of predicted DMI" .

dmi:Model_power_bi a dmi:ModelOutput,
        owl:NamedIndividual ;
    rdfs:label "power_bi" ;
    dmi:assignedToPhase dmi:Phase_Visualize ;
    rdfs:comment "Star-schema VDA surface" .

dmi:Model_shap a dmi:ModelOutput,
        owl:NamedIndividual ;
    rdfs:label "shap" ;
    dmi:assignedToPhase dmi:Phase_Explain ;
    rdfs:comment "Global and local factor attribution" .

dmi:Model_streamlit a dmi:ModelOutput,
        owl:NamedIndividual ;
    rdfs:label "streamlit" ;
    dmi:assignedToPhase dmi:Phase_Visualize ;
    rdfs:comment "Interactive VDA by country/indicator/phase" .

dmi:Model_two_way_fe a dmi:ModelOutput,
        owl:NamedIndividual ;
    rdfs:label "two_way_fe" ;
    dmi:assignedToPhase dmi:Phase_Analyse ;
    rdfs:comment "Two-way fixed effects (country and year), Driscoll-Kraay standard errors" .

dmi:Model_world_bank_api a dmi:ModelOutput,
        owl:NamedIndividual ;
    rdfs:label "world_bank_api" ;
    dmi:assignedToPhase dmi:Phase_Acquire ;
    rdfs:comment "Obtain official World Bank WDI series via HTTP API" .

dmi:OfficialEntry a owl:Class ;
    rdfs:label "Published cell" ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( dmi:ScoreEntry [ a owl:Restriction ;
                        owl:onProperty dmi:hasProvenance ;
                        owl:someValuesFrom dmi:OfficialState ] ) ] .

dmi:Prov_missing a dmi:MissingState,
        dmi:ProvenanceState ;
    rdfs:label "missing" .

