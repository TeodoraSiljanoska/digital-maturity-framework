dmi:Publisher a owl:Class ;
    rdfs:label "Publisher" ;
    rdfs:comment "Organisation that publishes an official series or index." ;
    rdfs:subClassOf prov:Organization .

dmi:CompetencyQuestion a owl:Class ;
    rdfs:subClassOf dmi:Ceval .

dmi:DispersionReading a owl:Class ;
    rdfs:label "Dispersion reading" ;
    rdfs:comment "Cross-country coefficient of variation of the DMI in one year (sigma convergence)." ;
    rdfs:subClassOf dmi:ModelOutput .

dmi:ValidationQuery a owl:Class ;
    rdfs:subClassOf dmi:Ceval .

dmi:Country a owl:Class ;
    rdfs:label "Country" ;
    rdfs:subClassOf dmi:Ctax .

dmi:Phase_Process a dmi:ProcessPhase ;
    rdfs:label "Process" ;
    dmi:precedes dmi:Phase_Index .

dmi:Phase_Visualize a dmi:ProcessPhase ;
    rdfs:label "Visualize" .

dmi:ForecastScore a owl:Class ;
    rdfs:label "Forecast score" ;
    rdfs:comment "Accuracy of one model under the rolling-origin protocol, relative to persistence." ;
    rdfs:subClassOf dmi:ModelOutput .

dmi:ModelOutput a owl:Class ;
    rdfs:subClassOf dmi:Cdec .

dmi:Phase_Predict a dmi:ProcessPhase ;
    rdfs:label "Predict" ;
    dmi:precedes dmi:Phase_Explain .

dmi:Estimate a owl:Class ;
    rdfs:label "Estimate" ;
    rdfs:comment "Coefficient of a panel model attached to one indicator, with standard error and p-value." ;
    rdfs:subClassOf dmi:ModelOutput .

dmi:Indicator a owl:Class ;
    rdfs:label "Indicator" ;
    rdfs:comment "Reusable measured or constructed variable with a project IRI (http://purl.org/dmi-framework#Ind_*), not a registered PURL." ;
    rdfs:subClassOf dmi:Ctax .

dmi:Phase_Analyse a dmi:ProcessPhase ;
    rdfs:label "Analyse" ;
    dmi:precedes dmi:Phase_Predict .

dmi:Ind_Z5 a dmi:ContextIndicator,
        dmi:Indicator,
        owl:NamedIndividual ;
    rdfs:label "Researchers in R&D"@en,
        "Истражувачи во И&Р"@mk ;
    dmi:hasSource dmi:Source_world_bank_context ;
    dmi:indicatorCode "SP.POP.SCIE.RD.P6" ;
    dmi:indicatorId "Z5" ;
    dmi:obtainedBy dmi:Method_official_api ;
    dmi:polarity "positive" ;
    dmi:primaryPublisher dmi:Publisher_unesco_uis ;
    dmi:relatedPillar dmi:Pillar_digital_economy ;
    dmi:role "context" ;
    dmi:unit "per million people" ;
    dmi:usedInPhase dmi:Phase_Acquire,
        dmi:Phase_Analyse,
        dmi:Phase_Process,
        dmi:Phase_Visualize .

dmi:Ind_Z6 a dmi:ContextIndicator,
        dmi:Indicator,
        owl:NamedIndividual ;
    rdfs:label "Statistical Performance Indicators, overall score"@en,
        "Статистички перформанси (SPI), вкупна оценка"@mk ;
    dmi:hasSource dmi:Source_world_bank_context ;
    dmi:indicatorCode "IQ.SPI.OVRL" ;
    dmi:indicatorId "Z6" ;
    dmi:obtainedBy dmi:Method_official_api ;
    dmi:polarity "positive" ;
    dmi:primaryPublisher dmi:Publisher_world_bank ;
    dmi:relatedPillar dmi:Pillar_e_government ;
    dmi:role "context" ;
    dmi:unit "score 0-100" ;
    dmi:usedInPhase dmi:Phase_Acquire,
        dmi:Phase_Analyse,
        dmi:Phase_Process,
        dmi:Phase_Visualize .

dmi:Prov_constructed a dmi:ConstructedState,
        dmi:ProvenanceState ;
    rdfs:label "constructed" .

dmi:Ind_Z3 a dmi:ContextIndicator,
        dmi:Indicator,
        owl:NamedIndividual ;
    rdfs:label "High-technology exports"@en,
        "Извоз на високотехнолошки производи"@mk ;
    dmi:hasSource dmi:Source_world_bank_context ;
    dmi:indicatorCode "TX.VAL.TECH.MF.ZS" ;
    dmi:indicatorId "Z3" ;
    dmi:obtainedBy dmi:Method_official_api ;
    dmi:polarity "positive" ;
    dmi:primaryPublisher dmi:Publisher_un_statistics_division ;
    dmi:relatedPillar dmi:Pillar_trust_innovation ;
    dmi:role "context" ;
    dmi:unit "% of manufactured exports" ;
    dmi:usedInPhase dmi:Phase_Acquire,
        dmi:Phase_Analyse,
        dmi:Phase_Process,
        dmi:Phase_Visualize .

dmi:Source_constructed a dmi:DataSource,
        owl:NamedIndividual ;
    rdfs:label "constructed" ;
    dcterms:title "Digital Maturity Framework (constructed index)"@en .

dmi:Source_gii a dmi:DataSource,
        owl:NamedIndividual ;
    rdfs:label "gii" ;
    dcterms:title "Global Innovation Index reports and data files"@en ;
    dmi:publishedBy dmi:Publisher_wipo .

dmi:Source_ncsi a dmi:DataSource,
        owl:NamedIndividual ;
    rdfs:label "ncsi" ;
    dcterms:title "NCSI 3.0 dated country pages"@en ;
    dmi:publishedBy dmi:Publisher_ega .

dmi:Source_oxford_insights a dmi:DataSource,
        owl:NamedIndividual ;
    rdfs:label "oxford_insights" ;
    dcterms:title "Government AI Readiness Index reports and data file"@en ;
    dmi:publishedBy dmi:Publisher_oxford_insights .

dmi:Source_undp a dmi:DataSource,
        owl:NamedIndividual ;
    rdfs:label "undp" ;
    dcterms:title "Human Development Report 2025 time series"@en ;
    dmi:publishedBy dmi:Publisher_undp_hdro .

dmi:Ind_Z4 a dmi:ContextIndicator,
        dmi:Indicator,
        owl:NamedIndividual ;
    rdfs:label "Tertiary school enrollment"@en,
        "Запишани во терциерно образование"@mk ;
