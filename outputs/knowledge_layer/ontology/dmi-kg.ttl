@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix dmi: <http://purl.org/dmi-framework#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix qb: <http://purl.org/linked-data/cube#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

dcterms:description a owl:AnnotationProperty .

dcterms:license a owl:AnnotationProperty .

dcterms:source a owl:AnnotationProperty .

dcterms:title a owl:AnnotationProperty .

dmi: a owl:Ontology ;
    rdfs:label "Digital Maturity Index Framework Ontology" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:source <https://doi.org/10.5281/zenodo.23043842> ;
    rdfs:comment "Process-oriented reusable-indicator ontology for cross-country digital maturity assessment and visual data analysis." ;
    owl:versionInfo "2.0.0" .

dmi:BackcastEntry a owl:Class ;
    rdfs:label "Backcast cell" ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( dmi:ScoreEntry [ a owl:Restriction ;
                        owl:onProperty dmi:hasReconstructionScope ;
                        owl:someValuesFrom dmi:BackcastScope ] ) ] .

dmi:BalkanEntry a owl:Class ;
    rdfs:label "Cell of a Balkan country" ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( dmi:ScoreEntry [ a owl:Restriction ;
                        owl:onProperty dmi:entryGroup ;
                        owl:someValuesFrom dmi:BalkanGroup ] ) ] .

dmi:CQ1 a dmi:CompetencyQuestion,
        owl:NamedIndividual ;
    dmi:questionText "By which collection method is each indicator obtained?" ;
    dmi:usesValidationQuery dmi:VQ_CQ1 .

dmi:CQ10 a dmi:CompetencyQuestion,
        owl:NamedIndividual ;
    dmi:questionText "Which lagged indicators are significant at 5% in the single-imputation and in the pooled fixed-effects estimates?" ;
    dmi:usesValidationQuery dmi:VQ_CQ10 .

dmi:CQ11 a dmi:CompetencyQuestion,
        owl:NamedIndividual ;
    dmi:questionText "How did the cross-country coefficient of variation of the DMI change between 2012 and 2025?" ;
    dmi:usesValidationQuery dmi:VQ_CQ11 .

dmi:CQ12 a dmi:CompetencyQuestion,
        owl:NamedIndividual ;
    dmi:questionText "Which models beat the persistence forecast with a bootstrap interval entirely below zero?" ;
    dmi:usesValidationQuery dmi:VQ_CQ12 .

dmi:CQ13 a dmi:CompetencyQuestion,
        owl:NamedIndividual ;
    dmi:questionText "From which editions were the published values of the AI Readiness Index read?" ;
    dmi:usesValidationQuery dmi:VQ_CQ13 .

dmi:CQ14 a dmi:CompetencyQuestion,
        owl:NamedIndividual ;
    dmi:questionText "Which analytic views show context indicators, and which slicer fields do they offer?" ;
    dmi:usesValidationQuery dmi:VQ_CQ14 .

dmi:CQ2 a dmi:CompetencyQuestion,
        owl:NamedIndividual ;
    dmi:questionText "Which provenance states do the cells of North Macedonia in 2025 have?" ;
    dmi:usesValidationQuery dmi:VQ_CQ2 .

dmi:CQ3 a dmi:CompetencyQuestion,
        owl:NamedIndividual ;
    dmi:questionText "In which process phase is each forecasting model assigned?" ;
    dmi:usesValidationQuery dmi:VQ_CQ3 .

dmi:CQ4 a dmi:CompetencyQuestion,
        owl:NamedIndividual ;
    dmi:questionText "Which five indicators have the highest mean |SHAP|, and for which model?" ;
    dmi:usesValidationQuery dmi:VQ_CQ4 .

dmi:CQ5 a dmi:CompetencyQuestion,
        owl:NamedIndividual ;
    dmi:questionText "What are the values, provenance, edition and source of the cells of North Macedonia in 2025?" ;
    dmi:usesValidationQuery dmi:VQ_CQ5 .

dmi:CQ6 a dmi:CompetencyQuestion,
        owl:NamedIndividual ;
    dmi:questionText "How many countries, indicators and cells does the graph hold?" ;
    dmi:usesValidationQuery dmi:VQ_CQ6 .

dmi:CQ7 a dmi:CompetencyQuestion,
        owl:NamedIndividual ;
    dmi:questionText "Which country series have no published value at all?" ;
    dmi:usesValidationQuery dmi:VQ_CQ7 .

dmi:CQ8 a dmi:CompetencyQuestion,
        owl:NamedIndividual ;
    dmi:questionText "What share of the composite-component cells of the Balkan group is published in each year?" ;
    dmi:usesValidationQuery dmi:VQ_CQ8 .

dmi:CQ9 a dmi:CompetencyQuestion,
        owl:NamedIndividual ;
    dmi:questionText "What is the latest published value of each context indicator for North Macedonia, and to which pillar is it related?" ;
    dmi:usesValidationQuery dmi:VQ_CQ9 .

dmi:CTX_hypothesis_confirmation a dmi:DecisionContext ;
    rdfs:label "Hypothesis confirmation" ;
    rdfs:comment "UL_HC analogue: FE coefficients, VIF process, SHAP ranking." .

dmi:CarriedEntry a owl:Class ;
    rdfs:label "Carried cell" ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( dmi:ScoreEntry [ a owl:Restriction ;
                        owl:onProperty dmi:hasProvenance ;
                        owl:someValuesFrom dmi:CarriedState ] ) ] .

dmi:ComponentEntry a owl:Class ;
    rdfs:label "Composite-component cell" ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( dmi:ScoreEntry [ a owl:Restriction ;
                        owl:onProperty dmi:entryPillar ;
                        owl:someValuesFrom dmi:CompositePillar ] ) ] .

dmi:CompositeComponent a owl:Class ;
    rdfs:label "Composite component" ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( dmi:Indicator [ a owl:Restriction ;
                        owl:onProperty dmi:belongsToPillar ;
                        owl:someValuesFrom dmi:CompositePillar ] ) ] .

dmi:ConstructedEntry a owl:Class ;
    rdfs:label "Constructed cell" ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( dmi:ScoreEntry [ a owl:Restriction ;
                        owl:onProperty dmi:hasProvenance ;
                        owl:someValuesFrom dmi:ConstructedState ] ) ] .

dmi:ContextEntry a owl:Class ;
    rdfs:label "Context cell" ;
    owl:disjointWith dmi:ReconstructedEntry ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( dmi:ScoreEntry [ a owl:Restriction ;
                        owl:onProperty dmi:entryIndicator ;
                        owl:someValuesFrom dmi:ContextIndicator ] ) ] .

