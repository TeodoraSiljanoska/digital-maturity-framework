        dmi:ProvenanceState ;
    rdfs:label "carried_forward" .

dmi:Source_world_bank_context a dmi:DataSource,
        owl:NamedIndividual ;
    rdfs:label "world_bank_context" ;
    dcterms:title "World Bank WDI API, vintage 2026-10-08 (context indicators)"@en ;
    dmi:publishedBy dmi:Publisher_world_bank ;
    dmi:retrievedAt "2026-10-08T20:09:01+00:00"^^xsd:dateTime .

dmi:Source_world_bank a dmi:DataSource,
        owl:NamedIndividual ;
    rdfs:label "world_bank" ;
    dcterms:title "World Bank WDI API, vintage 2026-08-09"@en ;
    dmi:publishedBy dmi:Publisher_world_bank ;
    dmi:retrievedAt "2026-08-09T20:18:24+00:00"^^xsd:dateTime .

dmi:Prov_official a dmi:OfficialState,
        dmi:ProvenanceState ;
    rdfs:label "official" .

dmi:Phase_Acquire a dmi:ProcessPhase ;
    rdfs:label "Acquire" ;
    dmi:precedes dmi:Phase_Validate .

dmi:Dataset_panel a qb:DataSet,
        owl:NamedIndividual ;
    dcterms:title "Digital maturity panel: 12 countries, 2012-2025, indicator x country x year"@en .

dmi:ScoreEntry a owl:Class ;
    rdfs:comment "Reified cell of M : Indicator × Phase × Country × Source → Value." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty dmi:entryIndicator ;
            owl:someValuesFrom dmi:Indicator ],
        [ a owl:Restriction ;
            owl:onProperty dmi:entryCountry ;
            owl:someValuesFrom dmi:Country ],
        [ a owl:Restriction ;
            owl:onProperty dmi:hasProvenance ;
            owl:someValuesFrom dmi:ProvenanceState ],
        [ a owl:Restriction ;
            owl:onProperty dmi:year ;
            owl:someValuesFrom xsd:integer ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:integer ;
                    owl:withRestrictions ( [ xsd:minInclusive 2012 ] [ xsd:maxInclusive 2025 ] ) ] ;
            owl:onProperty dmi:year ],
        dmi:Cdec,
        qb:Observation,
        prov:Entity .

[] a owl:AllDisjointClasses ;
    owl:members ( dmi:OfficialState dmi:CarriedState dmi:ReconstructedState dmi:MissingState dmi:ConstructedState ) .

[] a owl:AllDisjointClasses ;
    owl:members ( dmi:InteriorScope dmi:BackcastScope dmi:ForecastScope ) .

[] a owl:AllDisjointClasses ;
    owl:members ( dmi:Indicator dmi:Pillar dmi:Country dmi:CountryGroup dmi:DataSource dmi:CollectionMethod dmi:ProcessPhase dmi:ProvenanceState dmi:TimeSeries dmi:ScoreEntry dmi:ModelOutput dmi:Publisher dmi:ReconstructionScope dmi:AnalyticView ) .

[] a owl:AllDisjointClasses ;
    owl:members ( dmi:CoreIndicator dmi:ControlIndicator dmi:CompositeIndex dmi:ContextIndicator ) .

[] a owl:AllDisjointClasses ;
    owl:members ( dmi:Estimate dmi:ForecastScore dmi:DispersionReading ) .

