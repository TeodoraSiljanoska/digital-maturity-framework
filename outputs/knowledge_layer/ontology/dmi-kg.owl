    <dmi:estimateFor rdf:resource="http://purl.org/dmi-framework#Ind_Z1"/>
    <dmi:coefficient rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">-1.739212458269158</dmi:coefficient>
    <dmi:stdError rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.1094699864623679</dmi:stdError>
