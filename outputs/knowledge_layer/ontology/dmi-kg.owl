  <rdf:Description rdf:about="http://purl.org/dmi-framework#Est_mi_pooled_X6">
    <rdf:type rdf:resource="http://purl.org/dmi-framework#Estimate"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <dmi:estimateFor rdf:resource="http://purl.org/dmi-framework#Ind_X6"/>
    <dmi:coefficient rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.172146543205579</dmi:coefficient>
    <dmi:stdError rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.0986639241066941</dmi:stdError>
    <dmi:pValue rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.0827318208945542</dmi:pValue>
    <dmi:estimator>FE, lag 1, Rubin's rules over 10 imputations</dmi:estimator>
    <dmi:estimationArm>mi_pooled</dmi:estimationArm>
    <dmi:assignedToPhase rdf:resource="http://purl.org/dmi-framework#Phase_Analyse"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/dmi-framework#VQ_CQ3">
    <rdf:type rdf:resource="http://purl.org/dmi-framework#ValidationQuery"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <dmi:queryText>PREFIX dmi: &lt;http://purl.org/dmi-framework#&gt;
PREFIX rdfs: &lt;http://www.w3.org/2000/01/rdf-schema#&gt;
SELECT ?m ?ph WHERE { ?f a dmi:ForecastScore ; dmi:scoredModel ?mm . ?mm dmi:assignedToPhase ?p ; rdfs:label ?m . ?p rdfs:label ?ph } GROUP BY ?m ?ph ORDER BY ?m</dmi:queryText>
  </rdf:Description>
