  <rdf:Description rdf:about="http://purl.org/dmi-framework#VQ_CQ5">
    <rdf:type rdf:resource="http://purl.org/dmi-framework#ValidationQuery"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <dmi:queryText>PREFIX dmi: &lt;http://purl.org/dmi-framework#&gt;
PREFIX rdfs: &lt;http://www.w3.org/2000/01/rdf-schema#&gt;
SELECT ?id ?v ?p WHERE { ?e a dmi:ScoreEntry ; dmi:entryCountry dmi:Country_MKD ; dmi:year 2025 ; dmi:entryIndicator ?i ; dmi:matrixValue ?v ; dmi:hasProvenance ?pp ; dmi:entrySource ?s . ?i dmi:indicatorId ?id . BIND(STRAFTER(STR(?pp), 'Prov_') AS ?p) } ORDER BY ?id</dmi:queryText>
  </rdf:Description>
