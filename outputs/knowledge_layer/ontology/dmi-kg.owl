  <rdf:Description rdf:about="http://purl.org/dmi-framework#ForecastScore">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://purl.org/dmi-framework#ModelOutput"/>
    <rdfs:label>Forecast score</rdfs:label>
    <rdfs:comment>Accuracy of one model under the rolling-origin protocol, relative to persistence.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/dmi-framework#VQ_CQ2">
    <rdf:type rdf:resource="http://purl.org/dmi-framework#ValidationQuery"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <dmi:queryText>PREFIX dmi: &lt;http://purl.org/dmi-framework#&gt;
PREFIX rdfs: &lt;http://www.w3.org/2000/01/rdf-schema#&gt;
SELECT ?p (COUNT(?e) AS ?n) WHERE { ?e a dmi:ScoreEntry ; dmi:entryCountry dmi:Country_MKD ; dmi:year 2025 ; dmi:hasProvenance ?pp . BIND(STRAFTER(STR(?pp), 'Prov_') AS ?p) } GROUP BY ?p ORDER BY ?p</dmi:queryText>
  </rdf:Description>
