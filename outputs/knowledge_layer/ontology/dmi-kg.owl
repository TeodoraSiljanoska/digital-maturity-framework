  <rdf:Description rdf:about="http://purl.org/dmi-framework#VQ_CQ8">
    <rdf:type rdf:resource="http://purl.org/dmi-framework#ValidationQuery"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <dmi:queryText>PREFIX dmi: &lt;http://purl.org/dmi-framework#&gt;
PREFIX rdfs: &lt;http://www.w3.org/2000/01/rdf-schema#&gt;
SELECT ?y (SUM(IF(?p = dmi:Prov_official, 1, 0)) AS ?off) (COUNT(?e) AS ?n) WHERE {
  ?e a dmi:ScoreEntry ; dmi:year ?y ; dmi:hasProvenance ?p ; dmi:entryCountry/dmi:memberOf dmi:Group_balkan ;
     dmi:entryIndicator/dmi:belongsToPillar ?pl .
  VALUES ?pl { dmi:Pillar_infrastructure dmi:Pillar_e_government dmi:Pillar_skills dmi:Pillar_trust_innovation dmi:Pillar_digital_economy }
} GROUP BY ?y ORDER BY ?y</dmi:queryText>
  </rdf:Description>
