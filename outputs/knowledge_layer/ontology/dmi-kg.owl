  <rdf:Description rdf:about="http://purl.org/dmi-framework#VQ_CQ14">
    <rdf:type rdf:resource="http://purl.org/dmi-framework#ValidationQuery"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <dmi:queryText>PREFIX dmi: &lt;http://purl.org/dmi-framework#&gt;
PREFIX rdfs: &lt;http://www.w3.org/2000/01/rdf-schema#&gt;
SELECT DISTINCT ?view ?field WHERE { ?v a dmi:AnalyticView ; dmi:showsIndicator ?i ; dmi:slicerField ?field ; rdfs:label ?view . ?i a dmi:ContextIndicator . FILTER (LANG(?view) = 'en') } ORDER BY ?view ?field</dmi:queryText>
  </rdf:Description>
