  <rdf:Description rdf:nodeID="n1076e971fa454f2c8ace9197daec9f26b91">
    <rdf:first rdf:nodeID="n1076e971fa454f2c8ace9197daec9f26b89"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
