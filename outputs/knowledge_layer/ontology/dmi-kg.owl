  <rdf:Description rdf:about="http://purl.org/dmi-framework#VQ_CQ4">
    <rdf:type rdf:resource="http://purl.org/dmi-framework#ValidationQuery"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <dmi:queryText>PREFIX dmi: &lt;http://purl.org/dmi-framework#&gt;
PREFIX rdfs: &lt;http://www.w3.org/2000/01/rdf-schema#&gt;
SELECT ?id ?model WHERE { ?e a dmi:Explanation ; dmi:aboutIndicator ?i ; dmi:meanAbsShap ?s ; dmi:explainsOutput ?m . ?i dmi:indicatorId ?id . ?m rdfs:label ?model } ORDER BY DESC(?s) LIMIT 5</dmi:queryText>
  </rdf:Description>
