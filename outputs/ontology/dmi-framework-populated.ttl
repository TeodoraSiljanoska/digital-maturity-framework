dmi:CTX_overview_dashboard a dmi:DecisionContext ; rdfs:label "Dashboard overview slice" ; rdfs:comment "Not a Recommendation individual; VDA does not recommend a visualization technique." .
dmi:CTX_prediction_xai a dmi:DecisionContext ; rdfs:label "SHAP attribution context" ; rdfs:comment "TreeExplainer on frozen CatBoost (results/xai/xai_shap_global.meta.json)." .

dmi:CQ1 a dmi:CompetencyQuestion ; dmi:questionText "By which collection method is each indicator obtained?" ; dmi:usesValidationQuery dmi:VQ_CQ1 .
dmi:VQ_CQ1 a dmi:ValidationQuery ; dmi:queryText """
PREFIX dmi: <http://purl.org/dmi-framework#>
SELECT ?id ?method WHERE {
  ?ind a dmi:Indicator ;
       dmi:indicatorId ?id ;
       dmi:obtainedBy ?m .
  ?m rdfs:label ?method .
}
ORDER BY ?method ?id
""" .
dmi:CQ2 a dmi:CompetencyQuestion ; dmi:questionText "What provenance states appear for MKD in 2025?" ; dmi:usesValidationQuery dmi:VQ_CQ2 .
dmi:VQ_CQ2 a dmi:ValidationQuery ; dmi:queryText """
PREFIX dmi: <http://purl.org/dmi-framework#>
SELECT ?prov (COUNT(*) AS ?n) WHERE {
  ?se a dmi:ScoreEntry ;
      dmi:entryCountry dmi:Country_MKD ;
      dmi:year 2025 ;
      dmi:hasProvenance ?p .
  ?p rdfs:label ?prov .
}
GROUP BY ?prov
""" .
dmi:CQ3 a dmi:CompetencyQuestion ; dmi:questionText "In which process phase is CatBoost assigned?" ; dmi:usesValidationQuery dmi:VQ_CQ3 .
dmi:VQ_CQ3 a dmi:ValidationQuery ; dmi:queryText """
PREFIX dmi: <http://purl.org/dmi-framework#>
SELECT ?phase ?purpose WHERE {
  dmi:Model_catboost dmi:assignedToPhase ?ph ;
                     rdfs:comment ?purpose .
  ?ph rdfs:label ?phase .
}
""" .
dmi:CQ4 a dmi:CompetencyQuestion ; dmi:questionText "Which indicators have the highest mean |SHAP|?" ; dmi:usesValidationQuery dmi:VQ_CQ4 .
dmi:VQ_CQ4 a dmi:ValidationQuery ; dmi:queryText """
PREFIX dmi: <http://purl.org/dmi-framework#>
SELECT ?id ?shap WHERE {
  ?e a dmi:Explanation ;
     dmi:aboutIndicator ?ind ;
     dmi:meanAbsShap ?shap .
  ?ind dmi:indicatorId ?id .
}
ORDER BY DESC(?shap)
LIMIT 10
""" .
dmi:CQ5 a dmi:CompetencyQuestion ; dmi:questionText "What ScoreEntry values exist for MKD 2025, with provenance, phase, and source?" ; dmi:usesValidationQuery dmi:VQ_CQ5 .
dmi:VQ_CQ5 a dmi:ValidationQuery ; dmi:queryText """
PREFIX dmi: <http://purl.org/dmi-framework#>
SELECT ?id ?value ?prov ?phase ?source WHERE {
  ?se a dmi:ScoreEntry ;
      dmi:entryCountry dmi:Country_MKD ;
      dmi:year 2025 ;
      dmi:entryIndicator ?ind ;
      dmi:matrixValue ?value ;
      dmi:hasProvenance ?p ;
      dmi:entryPhase ?ph ;
      dmi:entrySource ?src .
  ?ind dmi:indicatorId ?id .
  ?p rdfs:label ?prov .
  ?ph rdfs:label ?phase .
  ?src rdfs:label ?source .
}
ORDER BY ?id
""" .
dmi:CQ6 a dmi:CompetencyQuestion ; dmi:questionText "How many countries and indicators are in the graph?" ; dmi:usesValidationQuery dmi:VQ_CQ6 .
dmi:VQ_CQ6 a dmi:ValidationQuery ; dmi:queryText """
PREFIX dmi: <http://purl.org/dmi-framework#>
SELECT (COUNT(DISTINCT ?c) AS ?n_countries) (COUNT(DISTINCT ?ind) AS ?n_indicators) WHERE {
  ?c a dmi:Country .
  ?ind a dmi:Indicator .
}
""" .

# ----- evaluation runs (rdflib SPARQL, reasoner none) -----

dmi:Eval_CQ1 a dmi:EvaluationRun ; rdfs:label "rdflib SPARQL CQ1" ; dmi:evaluates dmi:CQ1 ; dmi:evaluatedWith dmi:VQ_CQ1 ; dmi:validationPassed true .
dmi:Eval_CQ2 a dmi:EvaluationRun ; rdfs:label "rdflib SPARQL CQ2" ; dmi:evaluates dmi:CQ2 ; dmi:evaluatedWith dmi:VQ_CQ2 ; dmi:validationPassed true .
dmi:Eval_CQ3 a dmi:EvaluationRun ; rdfs:label "rdflib SPARQL CQ3" ; dmi:evaluates dmi:CQ3 ; dmi:evaluatedWith dmi:VQ_CQ3 ; dmi:validationPassed true .
dmi:Eval_CQ4 a dmi:EvaluationRun ; rdfs:label "rdflib SPARQL CQ4" ; dmi:evaluates dmi:CQ4 ; dmi:evaluatedWith dmi:VQ_CQ4 ; dmi:validationPassed true .
dmi:Eval_CQ5 a dmi:EvaluationRun ; rdfs:label "rdflib SPARQL CQ5" ; dmi:evaluates dmi:CQ5 ; dmi:evaluatedWith dmi:VQ_CQ5 ; dmi:validationPassed true .
dmi:Eval_CQ6 a dmi:EvaluationRun ; rdfs:label "rdflib SPARQL CQ6" ; dmi:evaluates dmi:CQ6 ; dmi:evaluatedWith dmi:VQ_CQ6 ; dmi:validationPassed true .
