dmi:Model_world_bank_api a dmi:ModelOutput ; rdfs:label "world_bank_api" ; rdfs:comment "Obtain official World Bank WDI series via HTTP API" ; dmi:assignedToPhase dmi:Phase_Acquire .
dmi:Model_curated_snapshot_loaders a dmi:ModelOutput ; rdfs:label "curated_snapshot_loaders" ; rdfs:comment "Load versioned UN EGDI, NCSI, GII, Oxford, UNDP snapshots" ; dmi:assignedToPhase dmi:Phase_Acquire .
dmi:Model_mice a dmi:ModelOutput ; rdfs:label "mice" ; rdfs:comment "Complete remaining missing cells; never overwrite official values" ; dmi:assignedToPhase dmi:Phase_Process .
dmi:Model_dmi_weighted_pillars a dmi:ModelOutput ; rdfs:label "dmi_weighted_pillars" ; rdfs:comment "Construct dependent variable Y" ; dmi:assignedToPhase dmi:Phase_Index .
dmi:Model_ols a dmi:ModelOutput ; rdfs:label "ols" ; rdfs:comment "Linear baseline for H1.6" ; dmi:assignedToPhase dmi:Phase_Predict .
dmi:Model_ridge a dmi:ModelOutput ; rdfs:label "ridge" ; rdfs:comment "Regularised linear baseline for H1.6" ; dmi:assignedToPhase dmi:Phase_Predict .
dmi:Model_linear_regression a dmi:ModelOutput ; rdfs:label "linear_regression" ; rdfs:comment "Linear baseline for H1.6" ; dmi:assignedToPhase dmi:Phase_Predict .
dmi:Model_random_forest a dmi:ModelOutput ; rdfs:label "random_forest" ; rdfs:comment "Non-linear prediction of DMI" ; dmi:assignedToPhase dmi:Phase_Predict .
dmi:Model_xgboost a dmi:ModelOutput ; rdfs:label "xgboost" ; rdfs:comment "Non-linear prediction of DMI" ; dmi:assignedToPhase dmi:Phase_Predict .
dmi:Model_lightgbm a dmi:ModelOutput ; rdfs:label "lightgbm" ; rdfs:comment "Non-linear prediction of DMI" ; dmi:assignedToPhase dmi:Phase_Predict .
dmi:Model_catboost a dmi:ModelOutput ; rdfs:label "catboost" ; rdfs:comment "Non-linear prediction of DMI" ; dmi:assignedToPhase dmi:Phase_Predict .
dmi:Model_svr a dmi:ModelOutput ; rdfs:label "svr" ; rdfs:comment "Non-linear prediction of DMI" ; dmi:assignedToPhase dmi:Phase_Predict .
dmi:Model_mlp a dmi:ModelOutput ; rdfs:label "mlp" ; rdfs:comment "Non-linear prediction of DMI (unstable on this n)" ; dmi:assignedToPhase dmi:Phase_Predict .
dmi:Model_shap a dmi:ModelOutput ; rdfs:label "shap" ; rdfs:comment "Global and local factor attribution" ; dmi:assignedToPhase dmi:Phase_Explain .
dmi:Model_lime a dmi:ModelOutput ; rdfs:label "lime" ; rdfs:comment "Local model-agnostic explanation" ; dmi:assignedToPhase dmi:Phase_Explain .
dmi:Model_pdp a dmi:ModelOutput ; rdfs:label "pdp" ; rdfs:comment "Marginal response of predicted DMI" ; dmi:assignedToPhase dmi:Phase_Explain .
dmi:Model_streamlit a dmi:ModelOutput ; rdfs:label "streamlit" ; rdfs:comment "Interactive VDA by country/indicator/phase" ; dmi:assignedToPhase dmi:Phase_Visualize .
